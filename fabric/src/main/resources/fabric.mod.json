{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/s-armaan/transparent-player-mod"
    },
    "license": "${license}",
    "environment": "client",
    "entrypoints": {
        "client": [
            "io.github.s_armaan.transparentplayer.TransparentPlayerFabric"
        ]
    },
    "mixins": [
        {
            "config": "${mod_id}.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${fabric_minecraft_range}",
        "java": ">=${java_version}"
    }
}
